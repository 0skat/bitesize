# ── Kindle Delivery ────────────────────────────────────────────────────────────
#
# 1. Find your Kindle email at:
#    Amazon → Account & Lists → Manage Your Content and Devices → Preferences → Personal Document Settings
#
# 2. Whitelist SMTP_USER as an approved sender in the same "Approved Personal Document E-mail List" section.
#
# 3. For Gmail, SMTP_PASSWORD must be an App Password (not your regular password).
#    Generate one at: https://myaccount.google.com/apppasswords

KINDLE_EMAIL=your-name@kindle.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
