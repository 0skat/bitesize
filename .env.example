# ── AI backend ────────────────────────────────────────────────────────────────
# One of: claude | antigravity | gemini | ollama
# AI_BACKEND=claude
# ANTIGRAVITY_MODEL=gemini-3.5-flash-high

# Claude Code CLI backend. Uses your existing Claude subscription when no
# ANTHROPIC_API_KEY is set; setting that variable switches to per-token API
# billing instead. Haiku is the right default here — the digest makes one call
# per batch of articles and asks only for JSON.
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_TIMEOUT=180

# ── Language ──────────────────────────────────────────────────────────────────
# AI_LANGUAGE sets the book's chrome: section labels, dates, tag names.
# One of: en | es | pt-BR
# AI_LANGUAGE=en
#
# SUMMARY_LANGUAGE sets the per-article summaries, independently of the chrome.
#   (unset) → follow AI_LANGUAGE
#   source  → keep each summary in the language the article was written in
#   en | es | pt-BR → translate every summary into that language
# SUMMARY_LANGUAGE=source

# ── What you want to read ─────────────────────────────────────────────────────
# USER_INTERESTS is free text. When set, relevance stops measuring general
# newsworthiness and starts measuring fit to you, scored per story on an
# absolute 0-100 scale rather than graded against the rest of its batch.
# USER_INTERESTS=espresso machines, self-hosted software, Formula 1

# Drop anything scoring below this (0-100). 0 keeps everything.
# Only meaningful once USER_INTERESTS is set.
# MIN_KEEP_SCORE=60

# Hard cap on stories per issue, highest score first. 0 means unlimited.
# MAX_ARTICLES_PER_ISSUE=20

# Keep only the newest N EPUBs in output/. 0 keeps every issue forever.
# OUTPUT_KEEP_ISSUES=7

# ── Kindle Delivery ────────────────────────────────────────────────────────────
#
# 1. Find your Kindle email at:
#    Amazon → Account & Lists → Manage Your Content and Devices → Preferences → Personal Document Settings
#
# 2. Whitelist SMTP_USER as an approved sender in the same "Approved Personal Document E-mail List" section.
#
# 3. For Gmail, SMTP_PASSWORD must be an App Password (not your regular password).
#    Generate one at: https://myaccount.google.com/apppasswords

KINDLE_EMAIL=your-name@kindle.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional: require Bearer token for dashboard write APIs (POST/PUT/DELETE)
# DASHBOARD_TOKEN=generate-a-long-random-string
